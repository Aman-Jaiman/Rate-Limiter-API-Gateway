# Server configuration

PORT=3001



# MongoDB connection string

MONGO_URI=mongodb://localhost:27017/rate-limiter



# Redis configuration

REDIS_URL=
REDIS_HOST=localhost

REDIS_PORT=6379


# Frontend origin. Localhost origins are allowed automatically in development.

FRONTEND_URL=http://localhost:5173

NODE_ENV=development




# Rate limiter algorithm

# Available options:
# fixed
# sliding-log
# sliding-window
# token
# leaky

RATE_LIMIT_ALGORITHM=fixed





# Parsed config value; the active per-key limit is loaded from the MongoDB API-key plan.

RATE_LIMIT_MAX_REQUESTS=10





# Window time in seconds
# Used by:
# fixed window
# sliding log
# sliding window counter

RATE_LIMIT_WINDOW=60





# Token bucket configuration
# Number of tokens added per second

TOKEN_BUCKET_REFILL_RATE=1





# Leaky bucket configuration
# Number of requests removed per second

LEAKY_BUCKET_RATE=1